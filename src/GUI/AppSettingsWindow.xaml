<Window x:Class="Switchie.AppSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Switchie Settings"
        Width="460"
        Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#111111" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <GroupBox Header="Rendering" Margin="0,0,0,10">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">Render Mode</TextBlock>
                                <ComboBox x:Name="cmbRenderMode" Grid.Row="0" Grid.Column="1" Margin="8,2,0,2" SelectionChanged="RenderModeChanged" />
                                <Button x:Name="btnRevertRenderMode" Grid.Row="0" Grid.Column="2" Width="28" Height="24" Margin="8,2,0,2" Content="↺" ToolTip="Revert to default" Click="RevertRenderMode_Click" />

                                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" 
                                           ToolTip="The pager's width is automatically calculated from this value and from the size&#10;of all available screen space as well as the amount of virtual desktops.">Pager Height</TextBlock>
                                <TextBox x:Name="txtPagerHeight" Grid.Row="1" Grid.Column="1" Margin="8,2,0,2" Padding="3" TextChanged="TextInputChanged" />
                                <Button x:Name="btnRevertPagerHeight" Grid.Row="1" Grid.Column="2" Width="28" Height="24" Margin="8,2,0,2" Content="↺" ToolTip="Revert to default" Click="RevertPagerHeight_Click" />

                                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center">Desktop Border Style</TextBlock>
                                <ComboBox x:Name="cmbDesktopBorderStyle" Grid.Row="2" Grid.Column="1" Margin="8,2,0,2" SelectionChanged="RenderModeChanged" />
                                <Button x:Name="btnRevertDesktopBorderStyle" Grid.Row="2" Grid.Column="2" Width="28" Height="24" Margin="8,2,0,2" Content="↺" ToolTip="Revert to default" Click="RevertDesktopBorderStyle_Click" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Icons Settings" Margin="0,0,0,10">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" ToolTip="Increases the space around all icons of a desktop." >Padding Size</TextBlock>
                                <TextBox x:Name="txtPaddingSize" Grid.Row="0" Grid.Column="1" Margin="8,2,0,2" Padding="3" TextChanged="TextInputChanged" />
                                <Button x:Name="btnRevertPaddingSize" Grid.Row="0" Grid.Column="2" Width="28" Height="24" Margin="8,2,0,2" Content="↺" ToolTip="Revert to default" Click="RevertPaddingSize_Click" />

                                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" ToolTip="Negative values are supported as well so less space is taken and the icons look stacked.">Icon Padding X</TextBlock>
                                <TextBox x:Name="txtIconPaddingX" Grid.Row="1" Grid.Column="1" Margin="8,2,0,2" Padding="3" TextChanged="TextInputChanged" />
                                <Button x:Name="btnRevertIconPaddingX" Grid.Row="1" Grid.Column="2" Width="28" Height="24" Margin="8,2,0,2" Content="↺" ToolTip="Revert to default" Click="RevertIconPaddingX_Click" />

                                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"
                                           ToolTip="Negative values are supported as well in case of a very small pager height&#10;like 40px which is ususally the size of the Windows Taskbar.">Icon Padding Y</TextBlock>

                                <TextBox x:Name="txtIconPaddingY" Grid.Row="2" Grid.Column="1" Margin="8,2,0,2" Padding="3" TextChanged="TextInputChanged" />
                                <Button x:Name="btnRevertIconPaddingY" Grid.Row="2" Grid.Column="2" Width="28" Height="24" Margin="8,2,0,2" Content="↺" ToolTip="Revert to default" Click="RevertIconPaddingY_Click" />
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Colors">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <GroupBox Header="Desktops" Margin="0,0,0,10">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">Background</TextBlock>
                                <Border x:Name="previewBackgroundColor" Grid.Row="0" Grid.Column="1" Margin="8,2,0,2" Width="32" HorizontalAlignment="Left" BorderThickness="1" BorderBrush="Gray" Grid.ColumnSpan="2" />
                                <Button Grid.Row="0" Grid.Column="2" Margin="0,2,0,2" Height="24" Content="Choose..." Click="ChooseBackgroundColor_Click" />
                                <Button x:Name="btnRevertBackgroundColor" Grid.Row="0" Grid.Column="3" Margin="8,2,0,2" Content="↺" ToolTip="Revert to default" Click="RevertBackgroundColor_Click" />

                                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Height="16">Border</TextBlock>
                                <Border x:Name="previewDesktopColor" Grid.Row="1" Grid.Column="1" Margin="8,2,0,2" Width="32" HorizontalAlignment="Left" BorderThickness="1" BorderBrush="Gray" Grid.ColumnSpan="2" />
                                <Button Grid.Row="1" Grid.Column="2" Margin="0,2,0,2" Height="24" Content="Choose..." Click="ChooseDesktopColor_Click" />
                                <Button x:Name="btnRevertDesktopColor" Grid.Row="1" Grid.Column="3" Margin="8,2,0,2" Content="↺" ToolTip="Revert to default" Click="RevertDesktopColor_Click" />

                                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Height="16">Border (Active)</TextBlock>
                                <Border x:Name="previewActiveDesktopBorderColor" Grid.Row="2" Grid.Column="1" Margin="8,2,0,2" Width="32" HorizontalAlignment="Left" BorderThickness="1" BorderBrush="Gray" Grid.ColumnSpan="2" />
                                <Button Grid.Row="2" Grid.Column="2" Margin="0,2,0,2" Height="24" Content="Choose..." Click="ChooseActiveDesktopBorderColor_Click" />
                                <Button x:Name="btnRevertActiveDesktopBorderColor" Grid.Row="2" Grid.Column="3" Margin="8,2,0,2" Content="↺" ToolTip="Revert to default" Click="RevertActiveDesktopBorderColor_Click" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Windows" Margin="0,0,0,10">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Height="16">Background</TextBlock>
                                <Border x:Name="previewWindowColor" Grid.Row="0" Grid.Column="1" Margin="8,2,0,2" Width="32" HorizontalAlignment="Left" BorderThickness="1" BorderBrush="Gray" Grid.ColumnSpan="2" />
                                <Button Grid.Row="0" Grid.Column="2" Margin="0,2,0,2" Height="24" Content="Choose..." Click="ChooseWindowColor_Click" />
                                <Button x:Name="btnRevertWindowColor" Grid.Row="0" Grid.Column="3" Margin="8,2,0,2" Content="↺" ToolTip="Revert to default" Click="RevertWindowColor_Click" />

                                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Height="16">Background (Active)</TextBlock>
                                <Border x:Name="previewActiveWindowColor" Grid.Row="1" Grid.Column="1" Margin="8,2,0,2" Width="32" HorizontalAlignment="Left" BorderThickness="1" BorderBrush="Gray" Grid.ColumnSpan="2" />
                                <Button Grid.Row="1" Grid.Column="2" Margin="0,2,0,2" Height="24" Content="Choose..." Click="ChooseActiveWindowColor_Click" />
                                <Button x:Name="btnRevertActiveWindowColor" Grid.Row="1" Grid.Column="3" Margin="8,2,0,2" Content="↺" ToolTip="Revert to default" Click="RevertActiveWindowColor_Click" />

                                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Height="16">Border</TextBlock>
                                <Border x:Name="previewWindowBorderColor" Grid.Row="2" Grid.Column="1" Margin="8,2,0,2" Width="32" HorizontalAlignment="Left" BorderThickness="1" BorderBrush="Gray" Grid.ColumnSpan="2" />
                                <Button Grid.Row="2" Grid.Column="2" Margin="0,2,0,2" Height="24" Content="Choose..." Click="ChooseWindowBorderColor_Click" />
                                <Button x:Name="btnRevertWindowBorderColor" Grid.Row="2" Grid.Column="3" Margin="8,2,0,2" Content="↺" ToolTip="Revert to default" Click="RevertWindowBorderColor_Click" />

                                <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Height="16">Border (Active)</TextBlock>
                                <Border x:Name="previewActiveWindowBorderColor" Grid.Row="3" Grid.Column="1" Margin="8,2,0,2" Width="32" HorizontalAlignment="Left" BorderThickness="1" BorderBrush="Gray" Grid.ColumnSpan="2" />
                                <Button Grid.Row="3" Grid.Column="2" Margin="0,2,0,2" Height="24" Content="Choose..." Click="ChooseActiveWindowBorderColor_Click" />
                                <Button x:Name="btnRevertActiveWindowBorderColor" Grid.Row="3" Grid.Column="3" Margin="8,2,0,2" Content="↺" ToolTip="Revert to default" Click="RevertActiveWindowBorderColor_Click" />
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Performance">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <GroupBox Header="Performance" Margin="0,0,0,10">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" 
                                           ToolTip="Delay for the main refresh cycle. &#10;Affects how often the currently opened windows &#10;(on all virtual desktops) are checked for changes. &#10;&#10;Lower values update the pager faster, but can increase CPU usage.">Primary Update Delay (ms)</TextBlock>
                                <TextBox x:Name="txtPrimaryDelay" Grid.Row="0" Grid.Column="1" Margin="8,2,0,2" Padding="3" TextChanged="TextInputChanged" ToolTip="Controls how often the primary update runs.&#10;Use milliseconds (ms)." />
                                <Button x:Name="btnRevertPrimaryDelay" Grid.Row="0" Grid.Column="2" Width="28" Height="24" Margin="8,2,0,2" Content="↺" ToolTip="Revert to default" Click="RevertPrimaryDelay_Click" />

                                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" 
                                           ToolTip="Delay for background/secondary updates.&#10;Affects how often the app window is checked for being covered by another one, &#10;this includes the Windows Taskbar. Also (re-)pins the app to all virtual desktops.&#10;Furthermore, changes regarding the amount of virtual desktops are detected.&#10;&#10;Some of those operations require more processing,&#10;that's why this delay should be higher than the primary one.">Secondary Update Delay (ms)</TextBlock>
                                <TextBox x:Name="txtSecondaryDelay" Grid.Row="1" Grid.Column="1" Margin="8,2,0,2" Padding="3" TextChanged="TextInputChanged" ToolTip="Controls how often the secondary update runs.&#10;Use milliseconds (ms)." />
                                <Button x:Name="btnRevertSecondaryDelay" Grid.Row="1" Grid.Column="2" Width="28" Height="24" Margin="8,2,0,2" Content="↺" ToolTip="Revert to default" Click="RevertSecondaryDelay_Click" />
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Width="100" Margin="0,0,8,0" Content="Defaults" Click="RevertAll_Click" />
            <Button Width="100" Margin="0,0,8,0" IsDefault="True" Content="Save" Click="Save_Click" />
            <Button Width="100" IsCancel="True" Content="Cancel" />
        </StackPanel>
    </Grid>
</Window>

